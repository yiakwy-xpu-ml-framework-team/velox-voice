# Copy to docker/multi_instances/.env (git-ignored). run.sh sources it.
#
# Working GPU (host physical index). Default 0; the H800 test box uses 5.
VELOX_GPU=0
#VELOX_GPU=5

# Entry port (API + webpage + WS all on this single port).
VELOX_PORT=8000

# Initial replica count (rescale later with: run.sh scale N).
REPLICAS=2

# Host path of the 11 GB ASR bundle (read-only mount).
#MODEL_HOST_DIR=/raid/yiakwy/models/asr_model

# CUDA base / torch index override (e.g. CUDA 12.8):
#BASE_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu22.04
#TORCH_INDEX=https://download.pytorch.org/whl/cu128
